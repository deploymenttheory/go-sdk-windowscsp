{
  "name": "DnsClient",
  "path": "./Device/Vendor/MSFT",
  "nodes": [
    {
      "name": "DynamicDNS",
      "path": "./Device/Vendor/MSFT/DnsClient/DynamicDNS",
      "format": "node",
      "access": [
        "Get"
      ],
      "occurrence": "One",
      "children": [
        {
          "name": "Enabled",
          "title": "Enable DDNS",
          "path": "./Device/Vendor/MSFT/DnsClient/DynamicDNS/Enabled",
          "format": "bool",
          "access": [
            "Get",
            "Replace"
          ],
          "occurrence": "One"
        },
        {
          "name": "Overwrite",
          "path": "./Device/Vendor/MSFT/DnsClient/DynamicDNS/Overwrite",
          "format": "bool",
          "access": [
            "Get",
            "Replace"
          ],
          "occurrence": "One"
        }
      ]
    },
    {
      "name": "Encryption",
      "path": "./Device/Vendor/MSFT/DnsClient/Encryption",
      "format": "node",
      "access": [
        "Get"
      ],
      "description": "Encrypted transport options for securing DNS traffic.",
      "occurrence": "One",
      "children": [
        {
          "name": "DoH",
          "path": "./Device/Vendor/MSFT/DnsClient/Encryption/DoH",
          "format": "node",
          "access": [
            "Get"
          ],
          "description": "DNS over HTTPS",
          "occurrence": "One",
          "children": [
            {
              "name": "Status",
              "path": "./Device/Vendor/MSFT/DnsClient/Encryption/DoH/Status",
              "format": "int",
              "access": [
                "Get",
                "Replace"
              ],
              "description": "Set if the DNS client is allowed to make DNS queries over HTTPS. The default state is to allow these queries.",
              "default": "0",
              "occurrence": "One",
              "allowedValues": {
                "type": "ENUM",
                "enum": [
                  {
                    "value": "0",
                    "description": "Allowed"
                  },
                  {
                    "value": "1",
                    "description": "Blocked"
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "DoT",
          "path": "./Device/Vendor/MSFT/DnsClient/Encryption/DoT",
          "format": "node",
          "access": [
            "Get"
          ],
          "description": "DNS over TLS",
          "occurrence": "One",
          "children": [
            {
              "name": "Status",
              "path": "./Device/Vendor/MSFT/DnsClient/Encryption/DoT/Status",
              "format": "int",
              "access": [
                "Get",
                "Replace"
              ],
              "description": "Set if the DNS client is allowed to make DNS queries over TLS. The default state is to allow these queries.",
              "default": "0",
              "occurrence": "One",
              "allowedValues": {
                "type": "ENUM",
                "enum": [
                  {
                    "value": "0",
                    "description": "Allowed"
                  },
                  {
                    "value": "1",
                    "description": "Blocked"
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "Status",
          "path": "./Device/Vendor/MSFT/DnsClient/Encryption/Status",
          "format": "int",
          "access": [
            "Get",
            "Replace"
          ],
          "description": "Define the system-wide status of encrypted DNS. Disabled will block any attempts at DoH or DoT through the client, Allowed offers both unencrypted requests, as well as encrypted requests when possible, and Enforced blocks any lookups that would be sent via an unencrypted configuration. The default value is",
          "occurrence": "One",
          "allowedValues": {
            "type": "ENUM",
            "enum": [
              {
                "value": "0",
                "description": "Unconfigured"
              },
              {
                "value": "1",
                "description": "Disabled"
              },
              {
                "value": "2",
                "description": "Allowed"
              },
              {
                "value": "3",
                "description": "Enforced"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "IDN",
      "path": "./Device/Vendor/MSFT/DnsClient/IDN",
      "format": "node",
      "access": [
        "Get"
      ],
      "occurrence": "One",
      "children": [
        {
          "name": "Encoded",
          "path": "./Device/Vendor/MSFT/DnsClient/IDN/Encoded",
          "format": "bool",
          "access": [
            "Get",
            "Replace"
          ],
          "occurrence": "One"
        },
        {
          "name": "Mapped",
          "path": "./Device/Vendor/MSFT/DnsClient/IDN/Mapped",
          "format": "bool",
          "access": [
            "Get",
            "Replace"
          ],
          "occurrence": "One"
        }
      ]
    },
    {
      "name": "LinkLocal",
      "path": "./Device/Vendor/MSFT/DnsClient/LinkLocal",
      "format": "node",
      "access": [
        "Get"
      ],
      "occurrence": "One",
      "children": [
        {
          "name": "LLMNR",
          "title": "Link-Local Multicast Name Resolution",
          "path": "./Device/Vendor/MSFT/DnsClient/LinkLocal/LLMNR",
          "format": "node",
          "access": [
            "Get"
          ],
          "description": "LLMNR (Link Local Multicast Name Resolution) is a legacy protocol for local device lookup.",
          "occurrence": "One",
          "children": [
            {
              "name": "Enabled",
              "path": "./Device/Vendor/MSFT/DnsClient/LinkLocal/LLMNR/Enabled",
              "format": "bool",
              "access": [
                "Get",
                "Replace"
              ],
              "occurrence": "One"
            }
          ]
        },
        {
          "name": "NetBIOS",
          "path": "./Device/Vendor/MSFT/DnsClient/LinkLocal/NetBIOS",
          "format": "node",
          "access": [
            "Get"
          ],
          "occurrence": "One",
          "children": [
            {
              "name": "AllowFQDN",
              "title": "Allow FQDN NetBIOS Lookups",
              "path": "./Device/Vendor/MSFT/DnsClient/LinkLocal/NetBIOS/AllowFQDN",
              "format": "bool",
              "access": [
                "Get",
                "Replace"
              ],
              "occurrence": "One"
            },
            {
              "name": "Enable",
              "title": "Enable NetBIOS",
              "path": "./Device/Vendor/MSFT/DnsClient/LinkLocal/NetBIOS/Enable",
              "format": "int",
              "access": [
                "Get",
                "Replace"
              ],
              "description": "NetBIOS can be fully disabled, disabled only on public networks, enabled in learning mode, or  enabled entirely. By default, it runs in Learning Mode.",
              "occurrence": "One",
              "allowedValues": {
                "type": "ENUM",
                "enum": [
                  {
                    "value": "0",
                    "description": "Disable NetBIOS"
                  },
                  {
                    "value": "1",
                    "description": "Allow NetBIOS"
                  },
                  {
                    "value": "2",
                    "description": "Disable NetBIOS on Public Networks"
                  },
                  {
                    "value": "3",
                    "description": "Run NetBIOS in Learning Mode"
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "mDNS",
          "title": "Multicast DNS",
          "path": "./Device/Vendor/MSFT/DnsClient/LinkLocal/mDNS",
          "format": "node",
          "access": [
            "Get"
          ],
          "occurrence": "One",
          "children": [
            {
              "name": "Enabled",
              "path": "./Device/Vendor/MSFT/DnsClient/LinkLocal/mDNS/Enabled",
              "format": "bool",
              "access": [
                "Get",
                "Replace"
              ],
              "occurrence": "One"
            }
          ]
        }
      ]
    },
    {
      "name": "NRPT",
      "title": "Name Resolution Policy Table",
      "path": "./Device/Vendor/MSFT/DnsClient/NRPT",
      "format": "node",
      "access": [
        "Get"
      ],
      "description": "Contains entries identifying which DNS server should be used for requests applying to specific domains.",
      "occurrence": "One",
      "atomicRequired": true,
      "children": [
        {
          "name": "",
          "title": "Policy Table Entry",
          "path": "./Device/Vendor/MSFT/DnsClient/NRPT/{Policy Table Entry}",
          "format": "node",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "A row in the name resolution policy table.",
          "occurrence": "ZeroOrMore",
          "dynamicNaming": "Numerical identifier, in order.",
          "allowedValues": {
            "type": "RegEx"
          },
          "atomicRequired": true,
          "children": [
            {
              "name": "DNSServers",
              "title": "DNS Servers",
              "path": "./Device/Vendor/MSFT/DnsClient/NRPT/{Policy Table Entry}/DNSServers",
              "format": "chr",
              "access": [
                "Get",
                "Replace"
              ],
              "description": "Space-separated list of IP addresses of DNS server(s) used to resolve names that match this policy.",
              "occurrence": "One",
              "atomicRequired": true
            },
            {
              "name": "Namespace",
              "title": "Entry namespace",
              "path": "./Device/Vendor/MSFT/DnsClient/NRPT/{Policy Table Entry}/Namespace",
              "format": "chr",
              "access": [
                "Get",
                "Replace"
              ],
              "description": "The domain name being routed under this policy. Depending on the NamespaceType value, this may be any one of: FQDN, domain suffix, hostname (of any given domain), or IPv4 or IPv6 subnet.",
              "occurrence": "One",
              "atomicRequired": true
            },
            {
              "name": "NamespaceType",
              "path": "./Device/Vendor/MSFT/DnsClient/NRPT/{Policy Table Entry}/NamespaceType",
              "format": "chr",
              "access": [
                "Get",
                "Replace"
              ],
              "description": "The type of the namespace declared by this table entry. This defines the scope that this policy applies to.",
              "occurrence": "One",
              "allowedValues": {
                "type": "ENUM",
                "enum": [
                  {
                    "value": "FQDN",
                    "description": "Fully-qualified domain name of a specific host"
                  },
                  {
                    "value": "Suffix",
                    "description": "A domain name consisting of one or more labels. Defines a scope consisting of all hosts and subdomains of the given domain."
                  },
                  {
                    "value": "Prefix",
                    "description": "A specific hostname, on any given domain."
                  },
                  {
                    "value": "v4Subnet",
                    "description": "An IPv4 subnet for reverse lookup"
                  },
                  {
                    "value": "v6Subnet",
                    "description": "An IPv6 subnet for reverse lookup"
                  }
                ]
              },
              "atomicRequired": true
            }
          ]
        }
      ]
    }
  ]
}
