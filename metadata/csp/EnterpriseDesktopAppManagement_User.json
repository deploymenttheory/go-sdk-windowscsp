{
  "name": "EnterpriseDesktopAppManagement",
  "path": "./User/Vendor/MSFT",
  "nodes": [
    {
      "name": "MSI",
      "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI",
      "format": "node",
      "access": [
        "Get"
      ],
      "description": "Product Type is MSI",
      "occurrence": "One",
      "children": [
        {
          "name": "",
          "title": "ProductID",
          "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}",
          "format": "node",
          "access": [
            "Add",
            "Delete",
            "Get"
          ],
          "description": "The MSI product code for the application.",
          "occurrence": "ZeroOrMore",
          "dynamicNaming": "The MSI product code for the application.",
          "atomicRequired": true,
          "children": [
            {
              "name": "DownloadInstall",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}/DownloadInstall",
              "format": "xml",
              "access": [
                "Add",
                "Delete",
                "Exec",
                "Get",
                "Replace"
              ],
              "description": "Executes the download and installation of the application. In Windows 10, version 1703 service release, a new tag \u003cDownloadFromAad\u003e was added to the \u003cEnforcement\u003e section of the XML. The default value is 0 (do not send token). This tag is optional and needs to be set to 1 in case the server wants the download URL to get the AADUserToken.",
              "occurrence": "One",
              "allowedValues": {
                "type": "None"
              }
            },
            {
              "name": "InstallDate",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}/InstallDate",
              "format": "chr",
              "access": [
                "Get"
              ],
              "description": "Installation date of the application.",
              "occurrence": "One"
            },
            {
              "name": "InstallPath",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}/InstallPath",
              "format": "chr",
              "access": [
                "Get"
              ],
              "description": "Installation path of the application.",
              "occurrence": "One"
            },
            {
              "name": "LastError",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}/LastError",
              "format": "int",
              "access": [
                "Get"
              ],
              "description": "The last error code during the application installation process. This is typically stored as an HRESULT format. Depending on what was occurring when the error happened, this could be the result of executing MSIExec.exe or the error result from an API that failed.",
              "occurrence": "One"
            },
            {
              "name": "LastErrorDesc",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}/LastErrorDesc",
              "format": "chr",
              "access": [
                "Get"
              ],
              "description": "Contains the last error code description. The LastErrorDesc value is looked up for the matching LastError value. Sometimes there is no LastErrorDesc returned.",
              "occurrence": "One"
            },
            {
              "name": "Name",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}/Name",
              "format": "chr",
              "access": [
                "Get"
              ],
              "description": "Name of the application.",
              "occurrence": "One"
            },
            {
              "name": "Publisher",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}/Publisher",
              "format": "chr",
              "access": [
                "Get"
              ],
              "description": "Publisher of application.",
              "occurrence": "One"
            },
            {
              "name": "Status",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}/Status",
              "format": "int",
              "access": [
                "Get"
              ],
              "description": "Status of the application. Valid values: 10-Initialized, 20-Download In Progress, 25-Pending Download Retry, 30-Download Failed, 40-Download Completed, 48-Pending User Session, 50-Enforcement In Progress, 55-Pending Enforcement Retry, 60-Enforcement Failed, 70-Enforcement Completed",
              "occurrence": "One"
            },
            {
              "name": "Version",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/{ProductID}/Version",
              "format": "chr",
              "access": [
                "Get"
              ],
              "description": "MSI Product Version",
              "occurrence": "One"
            }
          ]
        },
        {
          "name": "UpgradeCode",
          "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/UpgradeCode",
          "format": "node",
          "access": [
            "Get"
          ],
          "occurrence": "One",
          "applicability": {
            "minOsBuild": "10.0.14393",
            "cspVersion": "1.0"
          },
          "children": [
            {
              "name": "",
              "title": "Guid",
              "path": "./User/Vendor/MSFT/EnterpriseDesktopAppManagement/MSI/UpgradeCode/{Guid}",
              "format": "chr",
              "access": [
                "Get"
              ],
              "description": "A gateway (or device management server) uses this method to detect matching upgrade MSI product when a Admin wants to update an existing MSI app. If the same upgrade product is installed, then the update is allowed.",
              "occurrence": "OneOrMore",
              "dynamicNaming": "ClientInventory"
            }
          ]
        }
      ]
    }
  ]
}
