{
  "name": "EMAIL2",
  "path": "./User/Vendor/MSFT",
  "nodes": [
    {
      "name": "",
      "title": "Account GUID",
      "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}",
      "format": "node",
      "access": [
        "Add",
        "Delete",
        "Get",
        "Replace"
      ],
      "description": "This is unique and identifies a particular account. Also, we can only have 6 additional email accounts. So, depending on how many are already there on the device, we can have from 1 to 6.",
      "occurrence": "ZeroOrN",
      "dynamicNaming": "ServerGeneratedUniqueIdentifier",
      "allowedValues": {
        "type": "RegEx",
        "value": "\\{[0-9A-Fa-f]{8}\\-[0-9A-Fa-f]{4}\\-[0-9A-Fa-f]{4}\\-[0-9A-Fa-f]{4}\\-[0-9A-Fa-f]{12}\\}"
      },
      "children": [
        {
          "name": "ACCOUNTICON",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/ACCOUNTICON",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "The location of the icon associated with the account.  The account icon can be used as a tile in the Start list or an icon in the applications list under Settings, email \u0026 accounts. Some icons are already provided on the device. The suggested icon for POP/IMAP or generic ActiveSync accounts is at res://AccountSettingsSharedRes{ScreenResolution}!%s.genericmail.png. The suggested icon for Exchange Accounts is at res://AccountSettingsSharedRes{ScreenResolution}!%s.office.outlook.png. Custom icons can be added if desired.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "ACCOUNTTYPE",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/ACCOUNTTYPE",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Specifies the type of account. Valid values are: Email - normal email, VVM - visual voice mail",
          "occurrence": "One",
          "allowedValues": {
            "type": "ENUM",
            "enum": [
              {
                "value": "Email",
                "description": "normal email"
              },
              {
                "value": "VVM",
                "description": "visual voice mail"
              }
            ]
          }
        },
        {
          "name": "AUTHNAME",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/AUTHNAME",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the name used to authorize the user to a specific email account (also known as the user's logon name).",
          "occurrence": "One",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "AUTHREQUIRED",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/AUTHREQUIRED",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies whether the outgoing server requires authentication.\n                1 for TRUE\n                0 for FALSE(default).\n                Note: If this is not specified then SMTP authentication will not be done. Also, this is different from the SMTPALTENABLED. That is to specify different set of credentials for SMTP.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "ENUM",
            "enum": [
              {
                "value": "0",
                "description": "Server authentication is not required."
              },
              {
                "value": "1",
                "description": "Server authentication is required."
              }
            ]
          }
        },
        {
          "name": "AUTHSECRET",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/AUTHSECRET",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the user's password. The same password is used for SMTP authentication.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "CALENDARSERVER",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/CALENDARSERVER",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Server for calendar sync if it is different from the email server.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "CALENDARSERVERREQUIRESSL",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/CALENDARSERVERREQUIRESSL",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Indicates if the connection to the calendar server requires SSL.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "CALENDARSYNCSCHEDULE",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/CALENDARSYNCSCHEDULE",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Sets the schedule for syncing calendar items.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "CELLULARONLY",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/CELLULARONLY",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "If this flag is set, the account only uses the cellular network and not Wi-Fi.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "CONTACTSSERVER",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/CONTACTSSERVER",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Server for contact sync if it is different from the email server.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "CONTACTSSERVERREQUIRESSL",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/CONTACTSSERVERREQUIRESSL",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Indicates if the connection to the contact server requires SSL.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "CONTACTSSYNCSCHEDULE",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/CONTACTSSYNCSCHEDULE",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Sets the schedule for syncing contact items.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "DOMAIN",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/DOMAIN",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the incoming server credentials domain. Limited to 255 characters.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "DWNDAY",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/DWNDAY",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies how many days' worth of email should be downloaded from the server.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "ENUM",
            "enum": [
              {
                "value": "-1",
                "description": "Specifies that all email currently on the server should be downloaded."
              },
              {
                "value": "7",
                "description": "Specifies that 7 days’ worth of email should be downloaded."
              },
              {
                "value": "14",
                "description": "Specifies that 14 days’ worth of email should be downloaded."
              },
              {
                "value": "30",
                "description": "Specifies that 30 days’ worth of email should be downloaded."
              },
              {
                "value": "90",
                "description": "Specifies that 90 days’ worth of email should be downloaded."
              }
            ]
          }
        },
        {
          "name": "INSERVER",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/INSERVER",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies how many days' worth of email should be downloaded from the server. server name:port number",
          "occurrence": "One",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "KEEPMAX",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/KEEPMAX",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Specifies the maximum size for a message attachment. Attachments beyond this size will not be downloaded but it will remain on the server. The message itself will be downloaded. This value can be set only for IMAP4 accounts. The limit is specified in KB.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "ENUM",
            "enum": [
              {
                "value": "-1",
                "description": "No limit is enforced"
              },
              {
                "value": "0",
                "description": "No attachment is downloaded"
              },
              {
                "value": "25",
                "description": "25 KB"
              },
              {
                "value": "50",
                "description": "50 KB"
              },
              {
                "value": "100",
                "description": "100 KB"
              },
              {
                "value": "250",
                "description": "250 KB"
              }
            ]
          }
        },
        {
          "name": "LINGER",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/LINGER",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the length of time between email send/receive updates in minutes.  0 indicates that updates must be performed manually.",
          "default": "15",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "Range",
            "value": "[(-1)-2147483647]"
          }
        },
        {
          "name": "NAME",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/NAME",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the name of the sender displayed on a sent email. It should be set to the user’s name. Limited to 255 characters.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "OUTSERVER",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/OUTSERVER",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the name of the messaging service's outgoing email server. Limited to 62 characters. The value format is: server name:port number",
          "occurrence": "One",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "REPLYADDR",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/REPLYADDR",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the reply email address of the user (usually the same as the user email address). Sending email will fail without it. Limited to 255 characters.",
          "occurrence": "One",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "RETRIEVE",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/RETRIEVE",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Specifies the maximum size in bytes for messages retrieved from the incoming email server. Messages beyond this size are retrieved, but truncated.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "Range",
            "value": "[(-1)-2147483647]"
          }
        },
        {
          "name": "SERVERDELETEACTION",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/SERVERDELETEACTION",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies how message is deleted on server. The default action depends on the transport.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "ENUM",
            "enum": [
              {
                "value": "1",
                "description": "delete message on the server"
              },
              {
                "value": "2",
                "description": "keep the message on the server (delete to the Trash folder)."
              }
            ]
          }
        },
        {
          "name": "SERVICENAME",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/SERVICENAME",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the name of the email service to create or edit (32 characters maximum).",
          "occurrence": "One",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "SERVICETYPE",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/SERVICETYPE",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the type of email service to create or edit (for example, \"IMAP4\" or \"POP3\").",
          "occurrence": "One",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "SMTPALTAUTHNAME",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/SMTPALTAUTHNAME",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the display name associated with the user's alternative SMTP email account.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "SMTPALTDOMAIN",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/SMTPALTDOMAIN",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the domain name for the user's alternative SMTP account.",
          "occurrence": "ZeroOrOne",
