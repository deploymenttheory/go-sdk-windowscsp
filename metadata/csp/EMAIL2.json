          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/SMTPALTENABLED",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies if the user's alternate SMTP account is enabled.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "ENUM",
            "enum": [
              {
                "value": "0",
                "description": "The user's alternate SMTP email account is disabled."
              },
              {
                "value": "1",
                "description": "The user's alternate SMTP email account is enabled."
              }
            ]
          }
        },
        {
          "name": "SMTPALTPASSWORD",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/SMTPALTPASSWORD",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Character string that specifies the password for the user's alternate SMTP account.",
          "occurrence": "ZeroOrOne",
          "allowedValues": {
            "type": "None"
          }
        },
        {
          "name": "SYNCINGCONTENTTYPES",
          "path": "./User/Vendor/MSFT/EMAIL2/{Account GUID}/SYNCINGCONTENTTYPES",
          "format": "chr",
          "access": [
            "Add",
            "Delete",
            "Get",
            "Replace"
          ],
          "description": "Specifies a bitmask for which content types are supported for syncing (eg: Mail, Contacts, Calendar).",
          "occurrence": "One",
          "allowedValues": {
            "type": "Flag",
            "enum": [
              {
                "value": "0x0",
                "description": "No data"
              },
              {
                "value": "0x1",
                "description": "Contacts"
              },
              {
                "value": "0x2",
                "description": "Mail"
              },
              {
                "value": "0x4",
                "description": "Appointments"
              },
              {
                "value": "0x8",
                "description": "Tasks"
              },
              {
                "value": "0x10",
                "description": "Notes"
              },
              {
                "value": "0x60",
                "description": "Feeds"
              },
              {
                "value": "0x180",
                "description": "Network Photo"
              },
              {
                "value": "0x200",
                "description": "Group and room"
              },
              {
                "value": "0x400",
                "description": "Chat"
              },
              {
                "value": "0x800",
                "description": "Email Recipient Email"
              },
              {
                "value": "0x1000",
                "description": "Server Link"
              },
              {
                "value": "0xffffffff",
                "description": "All items"
              }
            ]
          }
        },
        {
          "name": "TAGPROPS",
